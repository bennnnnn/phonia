# Recall API — production secrets template (copy → .env.production, fill values).
# Import to Fly: ../../scripts/fly-secrets-import.sh
# Generate crypto secrets: ../../scripts/generate-prod-secrets.sh

ENVIRONMENT=production
DEV_AUTH_ENABLED=false
MOCK_LLM_ENABLED=false
PROCESS_ROLE=api

# --- Required (app will not boot without these) ---
JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
GOOGLE_CLIENT_ID=
OPENROUTER_API_KEY=
CORS_ORIGINS=https://app.recall.app
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# --- R2 attachments (required in production) ---
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=recall-attachments

# --- Apple Sign-In (iOS; default bundle audience) ---
APPLE_CLIENT_ID=com.recall.app

# --- Recommended ---
SENTRY_DSN=
TAVILY_API_KEY=
# Homework camera OCR (empty → Gemini vision-chat only; never train Mathpix)
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# Live Talk WebRTC (composer STT stays on OPENROUTER_API_KEY)
# OPENAI_API_KEY=

# --- Proxy / forwarded-IP ---
# Trust Fly's fly-client-ip / X-Forwarded-For so rate limiting + WS handshake
# keys on the real edge client IP, not the proxy's. Only set true behind a
# trusted proxy (Fly terminates TLS and sets these); the app still validates
# the peer is a trusted proxy via TRUSTED_PROXY_CIDRS before honoring them.
TRUST_X_FORWARDED_FOR=true
# The default TRUSTED_PROXY_CIDRS (core/settings/edge.py) cover Fly's private
# ranges; set it only if you pin a specific proxy egress.

# --- Optional tuning ---
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
DAILY_TOKEN_LIMIT=100000
DAILY_TOKEN_LIMIT_PRO=500000
# Required in production — UTC-day OpenRouter spend kill-switch (pauses MCP + background LLM).
DAILY_GLOBAL_SPEND_USD=100
# The foreground latency budgets (CHAT_STREAM_CONNECT_TIMEOUT_SECONDS,
# CHAT_STREAM_TIMEOUT_SECONDS, MEMORY_QUERY_EMBED_TIMEOUT_SECONDS) default to
# production's values; set one only to change production.
# Hard wall-clock cap for a healthy stream that continues producing chunks.
# CHAT_STREAM_MAX_SECONDS=600
RECENT_MESSAGE_WINDOW=20
WEB_SEARCH_ENABLED=true
PUSH_ENABLED=true

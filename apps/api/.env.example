DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?sslmode=require
# Per-instance pool (defaults: size=20, overflow=10, timeout=5s). Keep
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) * fly instances under Neon pooler ceiling.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# CONTEXT_DB_CONCURRENCY=3
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Sign in with Apple — native iOS audience (defaults to com.recall.app)
# APPLE_CLIENT_ID=com.recall.app
# Sign in with Apple key (Apple Developer → Keys → Sign in with Apple): account
# delete revokes the user's Apple grant with it. The key is the .p8 contents;
# "\n" escapes work. Unset: delete still works, the grant is not revoked.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# LLM — chat models route through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Composer dictation, read-aloud, and Live Talk use OpenAI directly.
# SPEECH_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
# SPEECH_TRANSCRIPTION_ENABLED=true
# Per-plan caps: <NAME> is Free, <NAME>_PLUS and <NAME>_PRO the paid plans.
# 0 leaves a feature out of that plan (modules/billing/entitlements.py).
# DAILY_SPEECH_TRANSCRIPTIONS=0
# DAILY_SPEECH_TRANSCRIPTIONS_PLUS=200
# DAILY_SPEECH_TRANSCRIPTIONS_PRO=200
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# SPEECH_REALTIME_VOICE_ENABLED=true
# Optional text-to-speech (read aloud) on OpenAI
# SPEECH_TTS_ENABLED=true
# Both current and legacy fast aliases use OpenAI.
# SPEECH_TTS_MODEL=openai/gpt-4o-mini-tts
# SPEECH_TTS_VOICE=alloy
# DAILY_SPEECH_TTS=0
# DAILY_SPEECH_TTS_PLUS=100
# DAILY_SPEECH_TTS_PRO=100
# Live talk is minutes per UTC calendar month; one session reserves up to
# LIVE_TALK_MAX_SESSION_SECONDS and needs LIVE_TALK_MIN_SESSION_SECONDS left.
# MONTHLY_LIVE_TALK_MINUTES=0
# MONTHLY_LIVE_TALK_MINUTES_PLUS=0
# MONTHLY_LIVE_TALK_MINUTES_PRO=60
# LIVE_TALK_MAX_SESSION_SECONDS=900
# LIVE_TALK_MIN_SESSION_SECONDS=60
# AI images a day per plan.
# DAILY_IMAGE_GENERATIONS=3
# DAILY_IMAGE_GENERATIONS_PLUS=10
# DAILY_IMAGE_GENERATIONS_PRO=15
# SPEECH_RATE_LIMIT_PER_MINUTE=10

TAVILY_API_KEY=

# Web search (Tavily primary — https://tavily.com; DuckDuckGo fallback when key unset)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_FALLBACK_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

DAILY_TOKEN_LIMIT=100000
DAILY_TOKEN_LIMIT_PLUS=500000
DAILY_TOKEN_LIMIT_PRO=500000
# UTC-day provider spend kill-switch (every model call, images, voice, live talk);
# at the cap new chat turns are refused. 0 = unlimited (local). Production requires > 0.
# DAILY_GLOBAL_SPEND_USD=100
# Keep advanced derivations and other structured answers from being cut off
# mid-response. Response-style prompts control brevity; this is only a ceiling.
MAX_OUTPUT_TOKENS=8192
# Abort hung chat streams after this many seconds with no new chunk (idle).
# CHAT_STREAM_TIMEOUT_SECONDS=30
# Hard cap on one provider stream (seconds). Stops a slow drip from holding the lock.
# CHAT_STREAM_MAX_SECONDS=600
# Abort hung background (non-streaming) LLM calls after this many seconds.
# BACKGROUND_LLM_TIMEOUT_SECONDS=60
# Global REST rate limit per authenticated user or IP (health/webhooks excluded). 0 disables.
# REST_RATE_LIMIT_PER_MINUTE=240
RECENT_MESSAGE_WINDOW=20

# RevenueCat (Project → API keys → Secret API key; Webhooks → Authorization header)
# REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_ENTITLEMENT_ID=pro

# Push notifications (Expo Push API — no extra key; requires device tokens from app)
PUSH_ENABLED=true

# Model-initiated owned tools (web_search / sympy / image_gen / image_search). Default on.
# MCP_TOOL_LOOP_ENABLED=true
# Separate output budget for the compact tool decision, before the visible answer.
# MCP_TOOL_LOOP_PROBE_MAX_TOKENS=1024

# SymPy symbolic math (solve, geometry, graph sampling — injected before LLM stream)
# MATH_TOOLS_ENABLED=true
# MATH_MAX_EXPR_LENGTH=256
# MATH_GRAPH_MAX_POINTS=300
# STEM_SOLVE_TIMEOUT_SECONDS=5.0
# Isolated SymPy worker slots (not one shared pool). Interactive slot wait is
# independent of the 5s solve timeout — do not raise this to hide queueing.
# SYMPY_MAX_WORKERS=3
# SYMPY_QUEUE_WAIT_SECONDS=2.0

# Optional Mathpix math OCR for the homework scanner. When unset, vision-chat
# (Gemini) transcribes. Homework images always send improve_mathpix=false.
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# MATHPIX_ENABLED=true

# CORS — comma-separated explicit origins. Required in production (the app
# rejects an empty value there). For the mobile app only, the API URL is set
# per-device in apps/mobile/.env and doesn't need to be listed here.
# The web client needs an explicit origin here (cookie sessions cannot use `*`),
# e.g. local Vite + prod:
#   CORS_ORIGINS=https://app.recall.app,http://localhost:5173
CORS_ORIGINS=https://app.recall.app

# Chat-history semantic RAG (embed past turns; top-k at turn start).
# CHAT_HISTORY_RAG_ENABLED=true
# CHAT_HISTORY_RAG_CHUNK_LIMIT=6

# Scanned / image-only PDFs: render pages then vision-chat OCR (same extract
# + attachment RAG path). Off to skip the extra vision calls.
# ATTACHMENT_OCR_ENABLED=true
# ATTACHMENT_OCR_MAX_PAGES=6
# ATTACHMENT_OCR_TIMEOUT_SECONDS=30
# ATTACHMENT_OCR_PAGE_TIMEOUT_SECONDS=12

# Attachments storage. Production requires STORAGE_BACKEND=r2 (local disk is
# ephemeral on Fly). Client uploads/downloads via presigned URLs so blobs never
# touch the API. R2 creds come from a Cloudflare API token with R2 read+write
# on the bucket.
STORAGE_BACKEND=local
# Durable local blobs (default ~/.recall/attachments). Do not use /tmp —
# macOS purges it and gallery/chat then 404 on /attachments/{id}/file.
# STORAGE_LOCAL_PATH=~/.recall/attachments
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=recall-attachments
# R2_ENDPOINT=  # optional; derived as https://<account_id>.r2.cloudflarestorage.com

# Optional error reporting (leave empty to disable). Production also emits
# one JSON log object per line (access lines use event=http_request).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Contact address on the privacy policy, terms and account-deletion pages
# (/legal/*). Production boot warns while it is empty; use a mailbox you read.
SUPPORT_EMAIL=support@recall.com

# Transactional email (Resend — https://resend.com)
# RESEND_API_KEY=
# EMAIL_FROM=Recall <noreply@yourdomain.com>

# Dev placeholders (set ENVIRONMENT=production and both flags false in production)
DEV_AUTH_ENABLED=true
MOCK_LLM_ENABLED=true
ENVIRONMENT=development
# Comma-separated user UUIDs allowed to call /admin/* when DEV_AUTH_ENABLED=true
# ADMIN_USER_IDS=

# Process role: all (local dev — HTTP + worker in one process), api (HTTP/WS only),
# worker (background jobs only — use `python -m app.worker_main`).
# PROCESS_ROLE=all

# Neon:  https://neon.tech  → Connection string → use asyncpg URL above
# Upstash: https://upstash.com → Redis → REST or redis URL (rediss://...)

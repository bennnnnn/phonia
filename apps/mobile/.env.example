EXPO_PUBLIC_API_URL=http://localhost:8000
# Required in EAS production/preview builds (set in Expo dashboard → Secrets, not localhost).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
# Android: create an OAuth client (type Android) in Google Cloud with package com.recall.app
# and the debug SHA-1 from ./scripts/android-debug-sha1.sh — uses the Web client ID above.
# Release builds need two more: the EAS upload key and Play's app signing key (docs/PRODUCTION.md §6).
# Optional dev login bypass (backend DEV_AUTH_ENABLED must also be true)
EXPO_PUBLIC_DEV_AUTH_ENABLED=false
# Remote push — UUID from https://expo.dev (Project → Project settings). Run: npx eas init
# EXPO_PUBLIC_EAS_PROJECT_ID=
# RevenueCat public SDK keys (Project → API keys → App-specific keys)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional Sentry crash reporting (leave unset to disable). Needs a native build.
# EXPO_PUBLIC_SENTRY_DSN=
# With the DSN set, an EAS release build uploads source maps and needs all three (EAS env vars;
# the token as Secret), or SENTRY_DISABLE_AUTO_UPLOAD=true to ship without the upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Settings → Help: Contact support, Report a problem and Send feedback email this address.
# The rows are hidden when unset. EAS production builds need the same value (an EAS
# environment variable), or the store build has no way to reach support.
EXPO_PUBLIC_SUPPORT_EMAIL=support@recall.com
